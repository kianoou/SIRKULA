# =========================================================
# SIRKULA — contoh konfigurasi environment
# Salin file ini menjadi .env lalu sesuaikan nilainya.
# JANGAN commit file .env yang berisi kredensial asli.
# =========================================================

NODE_ENV=development
PORT=4000

# --- Database MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sirkula
DB_PASSWORD=
DB_NAME=sirkula
DB_CONNECTION_LIMIT=10

# --- Autentikasi ---
# Wajib diganti dengan string acak minimal 32 karakter di production.
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
JWT_EXPIRES_IN=7d
# Set true bila aplikasi dilayani melalui HTTPS.
COOKIE_SECURE=false

# --- CORS ---
# Origin frontend (Vite dev server). Pisahkan dengan koma bila lebih dari satu.
CORS_ORIGIN=http://localhost:5173

# --- Upload lampiran ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=1310720

# --- Seeder ---
# Password untuk seluruh akun demo. GANTI sebelum deployment.
# Tanda # harus berada di dalam tanda kutip agar tidak dianggap komentar.
DEMO_PASSWORD="Sirkula#2026"
